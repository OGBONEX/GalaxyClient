<Application x:Class="GalaxyClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#0B1020" />
    <SolidColorBrush x:Key="PanelBackground" Color="#141B2E" />
    <SolidColorBrush x:Key="Accent" Color="#8B7CFF" />
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C3C9DA"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Resources>
</Application>
