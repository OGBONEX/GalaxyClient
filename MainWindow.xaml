<Window x:Class="GalaxyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galaxy Client" Height="760" Width="1180" MinHeight="650" MinWidth="960"
        Background="{StaticResource PageBackground}" Foreground="#F4F5FF">
  <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="18" Margin="0,0,22,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="✦  GALAXY" FontSize="21" FontWeight="Bold" Margin="3,5,0,30"/><TextBlock DockPanel.Dock="Bottom" Text="Galaxy Client • Early access" Foreground="#929BB5" TextWrapping="Wrap" Margin="4,16,4,4"/><StackPanel><Button Content="Home" Tag="0" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Minecraft versions" Tag="1" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Modrinth library" Tag="2" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Accounts • coming soon" IsEnabled="False" Style="{StaticResource NavButton}"/></StackPanel></DockPanel></Border>
    <TabControl x:Name="MainTabs" Grid.Column="1"><TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle>
      <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,2,4,24"><TextBlock Text="Welcome to your next world" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Your Minecraft library, profiles, and updates in one place." Foreground="#AAB2C8" Margin="0,7,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="20" Padding="32"><StackPanel VerticalAlignment="Center" MaxWidth="580" HorizontalAlignment="Left"><TextBlock Text="GALAXY CLIENT" Foreground="#A99FFF" FontSize="12" FontWeight="Bold"/><TextBlock Text="Build your Galaxy." FontSize="46" FontWeight="Bold" Margin="0,12,0,8"/><TextBlock Text="Browse official Minecraft Java versions, launch vanilla games with an offline profile, and discover community content through Modrinth. Microsoft sign-in and Modrinth content installs are in progress." TextWrapping="Wrap" Foreground="#AAB2C8" FontSize="16" LineHeight="25"/><Button Content="Explore Modrinth" Tag="2" Click="Navigate_Click" HorizontalAlignment="Left" Margin="0,26,0,0" Padding="18,11" Background="#7666F4" Foreground="White" BorderThickness="0"/></StackPanel></Border></Grid></TabItem>
      <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,2,4,20"><TextBlock Text="Minecraft versions" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Browse Mojang's official Java Edition version manifest." Foreground="#AAB2C8" Margin="0,7,0,0"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,14"><ComboBox x:Name="VersionTypePicker" Width="180" Height="38" SelectedIndex="0" SelectionChanged="VersionTypePicker_SelectionChanged"><ComboBoxItem Content="Releases" Tag="release"/><ComboBoxItem Content="Snapshots" Tag="snapshot"/></ComboBox><Button Content="Refresh versions" Click="RefreshVersions_Click" Margin="10,0,0,0" Padding="15,7" Background="#252E49" Foreground="White" BorderThickness="0"/><TextBox x:Name="OfflineNameBox" Width="150" Height="38" Margin="10,0,0,0" Padding="8" Text="Player" ToolTip="Offline profile name"/><Button Content="Install &amp; Play" Click="InstallAndPlay_Click" Margin="10,0,0,0" Padding="15,7" Background="#7666F4" Foreground="White" BorderThickness="0"/><TextBlock x:Name="VersionStatus" Text="Loading versions…" Foreground="#AAB2C8" VerticalAlignment="Center" Margin="14,0,0,0"/></DockPanel><Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="16" Padding="14"><ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0" Foreground="#F4F5FF"><ListBox.ItemTemplate><DataTemplate><Border Background="#101729" CornerRadius="10" Padding="13" Margin="0,0,0,8"><DockPanel><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding ReleaseTime, StringFormat={}{0:yyyy-MM-dd}}" Foreground="#AAB2C8"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></TabItem>
      <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="4,2,4,20"><TextBlock Text="Modrinth library" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Search community projects. Install support is coming next." Foreground="#AAB2C8" Margin="0,7,0,0"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="SearchBox" Width="320" Height="38" VerticalContentAlignment="Center" Padding="9" Background="#101729" Foreground="White" BorderBrush="#34405D" KeyDown="SearchBox_KeyDown"/><ComboBox x:Name="ProjectTypePicker" Width="170" Height="38" Margin="10,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Mods" Tag="mod"/><ComboBoxItem Content="Modpacks" Tag="modpack"/><ComboBoxItem Content="Resource packs" Tag="resourcepack"/><ComboBoxItem Content="Data packs" Tag="datapack"/><ComboBoxItem Content="Shaders" Tag="shader"/></ComboBox><Button Content="Search" Click="Search_Click" Margin="10,0,0,0" Padding="18,7" Background="#7666F4" Foreground="White" BorderThickness="0"/><TextBlock x:Name="SearchStatus" Text="Search Modrinth projects" Foreground="#AAB2C8" VerticalAlignment="Center" Margin="14,0,0,0"/></DockPanel><Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="16" Padding="14"><ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" Foreground="#F4F5FF"><ListBox.ItemTemplate><DataTemplate><Border Background="#101729" CornerRadius="10" Padding="15" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#AAB2C8" Margin="0,5,12,0"/><TextBlock Text="{Binding Meta}" Foreground="#A99FFF" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Open Modrinth" Tag="{Binding Url}" Click="OpenProject_Click" VerticalAlignment="Center" Padding="12,8" Background="#252E49" Foreground="White" BorderThickness="0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></TabItem>
    </TabControl></Grid></Window>
