<Window x:Class="GalaxyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galaxy Client" Height="720" Width="1120" MinHeight="620" MinWidth="900"
        Background="{StaticResource PageBackground}" Foreground="#F4F5FF">
  <Grid Margin="28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="18" Margin="0,0,22,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="✦  GALAXY" FontSize="21" FontWeight="Bold" Margin="3,5,0,30" />
          <Button Content="Home" Style="{StaticResource NavButton}" />
          <Button Content="Minecraft versions" Style="{StaticResource NavButton}" />
          <Button Content="Modrinth library" Style="{StaticResource NavButton}" />
          <Button Content="Accounts" Style="{StaticResource NavButton}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Galaxy Client • Setup preview" Foreground="#929BB5" TextWrapping="Wrap" Margin="4,16,4,4" />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="4,2,4,24">
        <StackPanel>
          <TextBlock Text="Welcome to your next world" FontSize="29" FontWeight="SemiBold" />
          <TextBlock Text="Your Minecraft library, profiles, and updates in one place." Foreground="#AAB2C8" Margin="0,7,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#1B2540" CornerRadius="14" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="●  Discord not connected" Foreground="#C7C9E8" /></Border>
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="20" Padding="32">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" MaxWidth="540" HorizontalAlignment="Left">
            <TextBlock Text="READY WHEN YOU ARE" Foreground="#A99FFF" FontSize="12" FontWeight="Bold" />
            <TextBlock Text="Build your Galaxy." FontSize="46" FontWeight="Bold" Margin="0,12,0,8" />
            <TextBlock Text="Choose a Minecraft version, add your favorite Modrinth content, and launch with the profile that fits your play style." TextWrapping="Wrap" Foreground="#AAB2C8" FontSize="16" LineHeight="25" />
            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
              <ComboBox x:Name="VersionPicker" Width="205" Height="42" FontSize="14" SelectedIndex="0"><ComboBoxItem Content="Select a version…" IsSelected="True" /></ComboBox>
              <Button Content="Install version" Click="InstallVersion_Click" Margin="12,0,0,0" Padding="18,9" Background="#252E49" Foreground="White" BorderThickness="0" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="#101729" CornerRadius="13" Padding="16" Margin="0,28,0,0">
            <DockPanel><StackPanel><TextBlock Text="Launcher updates" FontWeight="SemiBold" /><TextBlock Text="Updates will connect to the Galaxy Client GitHub Releases feed." Foreground="#AAB2C8" Margin="0,5,0,0" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="Not configured" Foreground="#F1C77B" VerticalAlignment="Center" Margin="14,0,0,0" /></DockPanel>
          </Border>
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" Text="Game files and profiles stay on this PC. Setup does not remove existing files." Foreground="#7F89A3" Margin="4,18,0,0" />
    </Grid>
  </Grid>
</Window>
